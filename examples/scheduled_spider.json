{
  "id": "scheduled-spider-demo",
  "name": "Scheduled spider demo",
  "version": "1.0",
  "type": "http",
  "start_urls": ["examples/fixtures/scheduled_cron_page.html"],
  "item_selector": "article.entry",
  "fields": [
    {
      "name": "title",
      "type": "css",
      "selector": ".title"
    }
  ],
  "scheduler": {
    "enabled": true,
    "type": "interval",
    "interval_seconds": 1800,
    "timezone": "UTC",
    "start_at": "2026-06-03T00:00:00Z",
    "misfire_policy": "run_once",
    "max_instances": 1
  }
}
