{
  "id": "feature09-proxy-round-robin",
  "name": "Feature09 Proxy Round Robin",
  "version": "1.0",
  "type": "http",
  "start_urls": [
    "examples/fixtures/proxy_page.html",
    "examples/fixtures/proxy_page.html"
  ],
  "item_selector": "article.item",
  "fields": [
    {"name": "title", "type": "css", "selector": ".title"}
  ],
  "proxy": {
    "enabled": true,
    "mode": "round_robin",
    "proxies": ["local-proxy-a", "local-proxy-b"],
    "fail_threshold": 1,
    "cooldown_seconds": 5
  }
}
