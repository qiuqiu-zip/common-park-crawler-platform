{
  "id": "observability-worker-job-demo",
  "name": "Observability worker job demo",
  "version": "1.0",
  "type": "http",
  "start_urls": ["examples/fixtures/observability_worker_page.html"],
  "item_selector": "article.item",
  "unique_fields": ["title"],
  "request": {
    "method": "GET",
    "response_type": "html",
    "timeout_seconds": 5
  },
  "observability": {
    "enabled": true,
    "log_level": "INFO",
    "structured_logs": true,
    "capture_request_timeline": true,
    "capture_response_metadata": true,
    "capture_record_samples": true,
    "record_sample_limit": 5,
    "redact_sensitive": true,
    "metrics_enabled": true,
    "run_report_enabled": true
  },
  "fields": [
    {"name": "title", "type": "css", "selector": "a.title"}
  ],
  "scheduler": {
    "type": "manual"
  }
}
