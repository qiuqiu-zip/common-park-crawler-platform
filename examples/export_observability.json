{
  "id": "export-observability-demo",
  "name": "Export observability demo",
  "version": "1.0",
  "type": "api",
  "start_urls": ["examples/fixtures/export_task_page.json"],
  "items_json_path": "items",
  "request": {
    "method": "GET",
    "response_type": "json",
    "timeout_seconds": 5
  },
  "observability": {
    "enabled": true,
    "structured_logs": true,
    "metrics_enabled": true,
    "run_report_enabled": true,
    "redact_sensitive": true
  },
  "export": {
    "formats": ["json", "jsonl", "csv", "xlsx"],
    "default_format": "json",
    "include_observability": true,
    "include_lifecycle": true,
    "redact_sensitive": true
  },
  "fields": [
    {"name": "id", "type": "json_path", "json_path": "id"},
    {"name": "title", "type": "json_path", "json_path": "title"},
    {"name": "token", "type": "json_path", "json_path": "token"}
  ],
  "scheduler": {
    "type": "manual"
  }
}
