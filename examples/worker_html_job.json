{
  "id": "worker-html-job-demo",
  "name": "Worker HTML job demo",
  "version": "1.0",
  "type": "http",
  "start_urls": ["examples/fixtures/worker_html_page.html"],
  "item_selector": "article.product",
  "unique_fields": ["title"],
  "request": {
    "method": "GET",
    "response_type": "html",
    "timeout_seconds": 5
  },
  "fields": [
    {
      "name": "title",
      "type": "css",
      "selector": "a.title"
    },
    {
      "name": "price",
      "type": "regex",
      "pattern": "\\$(\\d+(?:\\.\\d+)?)",
      "transforms": ["float"]
    }
  ],
  "scheduler": {
    "type": "manual"
  }
}
