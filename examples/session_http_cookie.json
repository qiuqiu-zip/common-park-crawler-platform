{
  "id": "session-http-cookie-demo",
  "name": "Session HTTP cookie demo",
  "version": "1.0",
  "type": "api",
  "start_urls": ["examples/fixtures/session_public.json"],
  "items_json_path": "items",
  "fields": [
    {"name": "id", "type": "json_path", "json_path": "id"},
    {"name": "title", "type": "json_path", "json_path": "title"}
  ],
  "unique_fields": ["id"],
  "request": {"response_type": "json"},
  "session": {
    "enabled": true,
    "profile": "session-http-cookie-demo",
    "persist": true,
    "load_before_request": true,
    "save_after_request": true,
    "auth_check": {
      "enabled": true,
      "type": "status_code",
      "expected_status": 200
    }
  }
}
