{
  "id": "proxy-antibot-demo",
  "name": "Proxy anti-bot demo",
  "version": "1.0",
  "type": "playwright",
  "start_urls": ["examples/fixtures/antibot_page.html"],
  "item_selector": "article.item",
  "fields": [
    {
      "name": "title",
      "type": "css",
      "selector": ".title"
    }
  ],
  "request": {
    "user_agent": "CommonParkCrawler/0.1",
    "headers": {
      "Accept-Language": "en-US,en;q=0.9"
    },
    "delay_seconds": 2,
    "max_retries": 2
  },
  "proxy": {
    "enabled": true,
    "mode": "round_robin",
    "proxies": ["local-proxy-a"],
    "fail_threshold": 1,
    "cooldown_seconds": 5
  },
  "anti_bot": {
    "respect_robots_txt": true,
    "random_delay": true,
    "min_delay_seconds": 1,
    "max_delay_seconds": 3,
    "user_agents": ["CommonParkCrawler/0.1"]
  },
  "playwright": {
    "enabled": true,
    "browser_pool_size": 2,
    "wait_until": "networkidle"
  },
  "scheduler": {
    "type": "manual"
  }
}
