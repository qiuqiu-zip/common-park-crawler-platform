{
  "id": "scheduled-manual-demo",
  "name": "Scheduled manual demo",
  "version": "1.0",
  "type": "http",
  "start_urls": ["examples/fixtures/scheduled_cron_page.html"],
  "item_selector": "article.entry",
  "unique_fields": ["title"],
  "fields": [
    {
      "name": "title",
      "type": "css",
      "selector": "a.title"
    }
  ],
  "scheduler": {
    "enabled": true,
    "type": "manual",
    "timezone": "UTC",
    "max_instances": 1
  }
}
