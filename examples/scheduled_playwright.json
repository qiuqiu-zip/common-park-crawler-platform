{
  "id": "scheduled-playwright-demo",
  "name": "Scheduled Playwright demo",
  "version": "1.0",
  "type": "playwright",
  "start_urls": ["examples/fixtures/scheduled_playwright_page.html"],
  "item_selector": "article.result",
  "unique_fields": ["title"],
  "fields": [
    {
      "name": "title",
      "type": "css",
      "selector": "a.title"
    }
  ],
  "playwright": {
    "enabled": true,
    "headless": true,
    "browser_pool_size": 1,
    "wait_until": "domcontentloaded"
  },
  "scheduler": {
    "enabled": true,
    "type": "interval",
    "interval_seconds": 120,
    "timezone": "UTC",
    "start_at": "2026-06-03T00:00:00Z",
    "misfire_policy": "run_once",
    "max_instances": 1,
    "jitter_seconds": 0
  }
}
