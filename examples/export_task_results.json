{
  "id": "export-task-results-demo",
  "name": "Export task results demo",
  "version": "1.0",
  "type": "api",
  "start_urls": ["examples/fixtures/export_task_page.json"],
  "items_json_path": "items",
  "unique_fields": ["id"],
  "request": {
    "method": "GET",
    "response_type": "json",
    "timeout_seconds": 5
  },
  "dedup": {
    "enabled": true,
    "keys": ["id"],
    "scope": "task",
    "skip_existing": true,
    "include_source_url": true
  },
  "export": {
    "formats": ["json", "jsonl", "csv", "xlsx"],
    "default_format": "jsonl",
    "include_dedup": true,
    "redact_sensitive": true,
    "nested_strategy": "flatten_dot",
    "list_strategy": "json_string"
  },
  "fields": [
    {"name": "id", "type": "json_path", "json_path": "id"},
    {"name": "title", "type": "json_path", "json_path": "title"},
    {"name": "category", "type": "json_path", "json_path": "category"},
    {"name": "token", "type": "json_path", "json_path": "token"}
  ],
  "scheduler": {
    "type": "manual"
  }
}
