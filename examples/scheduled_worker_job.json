{
  "id": "scheduled-worker-job-demo",
  "name": "Scheduled worker job demo",
  "version": "1.0",
  "type": "api",
  "start_urls": ["examples/fixtures/scheduled_worker_page.json"],
  "items_json_path": "items",
  "unique_fields": ["id"],
  "request": {
    "method": "GET",
    "response_type": "json",
    "timeout_seconds": 5
  },
  "fields": [
    {
      "name": "id",
      "type": "json_path",
      "json_path": "id"
    },
    {
      "name": "title",
      "type": "json_path",
      "json_path": "title"
    }
  ],
  "scheduler": {
    "enabled": true,
    "type": "interval",
    "interval_seconds": 60,
    "timezone": "UTC",
    "start_at": "2026-06-03T00:00:00Z",
    "misfire_policy": "run_once",
    "max_instances": 1
  }
}
