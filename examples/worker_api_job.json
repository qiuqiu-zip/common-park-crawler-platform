{
  "id": "worker-api-job-demo",
  "name": "Worker API job demo",
  "version": "1.0",
  "type": "api",
  "start_urls": ["examples/fixtures/worker_api_page.json"],
  "items_json_path": "data.items",
  "unique_fields": ["id"],
  "request": {
    "method": "GET",
    "response_type": "json",
    "timeout_seconds": 5
