  "fields": [
    {
      "name": "id",
      "type": "json_path",
      "json_path": "id"
    },
    {
      "name": "title",
      "type": "json_path",
      "json_path": "title"
    }
  ],
  "scheduler": {
    "type": "manual"
  }
}
